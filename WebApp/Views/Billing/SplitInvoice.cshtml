@model List<WebApp.Models.FwInvoiceItem>
@using System.Text.Json
@{
    var invoice = (WebApp.Models.FwInvoice)ViewBag.Invoice;
    ViewData["Title"] = "Split Invoice";
}
<div class="container py-4">
    <h3>Split Invoice @invoice.InvoiceNo</h3>
    <p>Select the items to move to a new invoice. The original invoice keeps the remaining items.</p>
    <form id="splitForm">
        @Html.AntiForgeryToken()
        <input type="hidden" id="invoiceId" value="@invoice.InvoiceId" />
        <input type="hidden" id="invoiceNo" value="@invoice.InvoiceNo" />
        <div class="row g-3 mb-3">
            <div class="col-md-4"><label class="form-label">Owner / Driver Name</label><input class="form-control" id="ownerName" value="@invoice.OwnerName" /></div>
            <div class="col-md-4"><label class="form-label">Vehicle No</label><input class="form-control" id="vehicleNo" value="@invoice.VehicleNo" /></div>
            <div class="col-md-4"><label class="form-label">E-Way Bill No</label><input class="form-control" id="eWayBillNo" value="@invoice.WayBill" /></div>
        </div>
        <table class="table table-dark table-striped">
            <thead><tr><th>Select</th><th>Item</th><th>Quantity</th><th>Total</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><input class="split-item" type="checkbox" value="@item.ItemId" /></td>
                    <td>@(item.Item?.ItemName ?? $"Item {item.ItemId}")</td>
                    <td>@item.Quantity</td>
                    <td>@item.TotalCost.ToString("0.00")</td>
                </tr>
            }
            </tbody>
        </table>
        <button type="submit" class="btn btn-primary">Create Split Invoice</button>
        <a class="btn btn-secondary" href="@Url.Action("ViewBills", "Home")">Cancel</a>
    </form>
</div>
@section Scripts {
<script>
document.getElementById('splitForm').addEventListener('submit', function (e) {
    e.preventDefault();
    const ids = Array.from(document.querySelectorAll('.split-item:checked')).map(x => x.value);
    if (!ids.length) { alert('Select at least one item.'); return; }
    const body = new URLSearchParams();
    body.set('invoiceId', document.getElementById('invoiceId').value);
    body.set('invoiceNo', document.getElementById('invoiceNo').value);
    body.set('ownerName', document.getElementById('ownerName').value);
    body.set('vehicleNo', document.getElementById('vehicleNo').value);
    body.set('eWayBillNo', document.getElementById('eWayBillNo').value);
    body.set('itemIds', ids.join(','));
    body.set('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
    fetch('@Url.Action("SplitInvoice", "Billing")', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
      .then(r => r.json()).then(r => { if (!r.success) { alert(r.message || 'Unable to split invoice.'); return; } alert('Created invoice ' + r.invoiceNo); window.location.href = '@Url.Action("ViewBills", "Home")'; })
      .catch(() => alert('Unable to split invoice.'));
});
</script>
}
