@{
    ViewData["Title"] = "Billing";
    var godowns = ViewBag.Godowns as List<WebApp.Models.FwMasterGodown> ?? new List<WebApp.Models.FwMasterGodown>();
}

<div class="container-fluid mt-0 mb-1">
    <div class="dashboard-header">
        <h3>Billing</h3>
    </div>

    <div class="row mt-2">
        <div class="col-12">
            <div class="card mb-2">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="row">
                                <div class="col-md-4">
                                    <label>Customer Type</label>
                                    <select id="customerType" class="form-control">
                                        <option value="">-- Select Customer Type --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label>Mobile</label>
                                    <input id="mobile" type="tel" class="form-control" placeholder="Enter mobile number" maxlength="10" inputmode="numeric" oninput="this.value=this.value.replace(/\D/g,'')" />
                                    <input type="hidden" id="customerId" value="0" />
                                </div>
                                <div class="col-md-4">
                                    <label>WhatsApp</label>
                                    <input id="mobile2" type="tel" class="form-control" placeholder="Enter whatsapp number (optional)" maxlength="10" inputmode="numeric" oninput="this.value=this.value.replace(/\D/g,'')" />
                                </div>
                                <div class="col-md-8">
                                    <label>Customer Name</label>
                                    <input id="customerName" class="form-control" placeholder="Enter customer name" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label>Address</label>
                            <textarea id="address" class="form-control min-h-85" placeholder="Enter address"></textarea>
                        </div>
                    </div>
                    <div class="row my-2">
                        <div class="col-md-3">
                            <label for="itemSearch">Item Code / Name</label>
                            <input id="itemSearch" class="form-control" placeholder="Search by item code or name" autocomplete="off" />
                            <input id="itemCode" type="hidden" />
                            <input id="itemName" type="hidden" />
                        </div>
                        <div class="col-md-2">
                            <label>Item Type</label>
                            <select id="itemType" class="form-control"><option value="0">-- Select Type --</option></select>
                        </div>
                        <div class="col-md-2">
                            <label>Quantity</label>
                            <input id="itemQty" type="number" step="1" min="1" value="" class="form-control" placeholder="Qty" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                        </div>
                        <div class="col-md-2">
                            <label>Cost</label>
                            <input id="itemCost" type="number" step="0.01" min="0" class="form-control" placeholder="Individual price"
                                   oninput="this.value=this.value.replace(/[^0-9.]/g,''); var parts=this.value.split('.'); if(parts.length>2) this.value=parts[0]+'.'+parts.slice(1).join(''); if(parts[1]) parts[1]=parts[1].slice(0,2); this.value=parts.join('.')" />
                        </div>
                        <div class="col-md-2">
                            <label>Total</label>
                            <input id="itemTotal" type="number" step="0.01" class="form-control text-light" readonly value="0.00" />
                        </div>
                        <div class="col-md-1 align-self-end">
                            <button id="addItemBtn" class="btn btn-primary">Add</button>
                        </div>
                    </div>
                    <div class="tabulator-wrapper">
                        <div id="itemsTable"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Controls placed below the items grid -->
    <div class="row mt-2">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row mt-3">
                        <div class="col-md-3">
                            <label class="d-block">Print Size</label>
                            <div>
                                <label class="form-check-inline mr-3"><input class="form-check-input" type="radio" name="printSize" id="A4" value="A4" checked /> A4</label>
                                <label class="form-check-inline"><input class="form-check-input" type="radio" name="printSize" id="Thermal" value="Thermal" /> Thermal</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="d-block">Type</label>
                            <div>
                                <label class="form-check-inline mr-3"><input class="form-check-input" type="radio" name="isEstimate" id="estimateRadio" value="estimate" checked /> Estimate</label>
                                <label class="form-check-inline"><input class="form-check-input" type="radio" name="isEstimate" id="invoiceRadio" value="invoice" /> Invoice</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Bill Amount</label>
                                <input id="billAmount" type="number" step="0.01" class="form-control text-light" readonly value="0" placeholder="0.00" />
                            </div>
                        </div>
                        <!-- AmountPaid/Balance moved below invoice details -->
                        <div class="col-md-3">
                            <div class="form-group d-none">
                                <label>Discount per Item (%)</label>
                                <input id="discountPerItem" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="0.00"
                                       oninput="this.value=this.value.replace(/[^0-9.]/g,''); var parts=this.value.split('.'); if(parts.length>2) this.value=parts[0]+'.'+parts.slice(1).join(''); if(parts[1]) parts[1]=parts[1].slice(0,2); this.value=parts.join('.'); if(Number(this.value)>100) this.value='100';" />
                            </div>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-12">
                            <fieldset id="invoiceDetailsFieldset" class="border p-2 d-none">
                                <legend class="w-auto">Invoice Details</legend>
                                <!-- 4 columns layout: two rows of 4 cols -->
                                <div class="row">
                                    <div class="col-md-3">
                                        <label>Discount Percentage</label>
                                        <input id="discountPercentage" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="Discount percentage"
                                               oninput="this.value=this.value.replace(/[^0-9.]/g,''); var parts=this.value.split('.'); if(parts.length>2) this.value=parts[0]+'.'+parts.slice(1).join(''); if(parts[1]) parts[1]=parts[1].slice(0,2); this.value=parts.join('.')" />
                                    </div>
                                    <div class="col-md-3">
                                        <label>Taxable Amount</label>
                                        <input id="taxableAmount" type="number" step="0.01" class="form-control text-light" readonly value="0" placeholder="0.00" />
                                    </div>
                                    <div class="col-md-3">
                                        <label>With/Out of State</label>
                                        <div class="d-flex align-items-center">
                                            <label class="mr-3 mb-0"><input type="radio" name="stateType" value="in" checked class="mr-1" /> In State</label>
                                            <label class="mb-0"><input type="radio" name="stateType" value="out" class="mr-1" /> Out of State</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label>Invoice No</label>
                                        <input id="invoiceNo" class="form-control" placeholder="Invoice no" />
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-md-3">
                                        <label>CGST</label>
                                        <input id="cgst" type="number" step="0.01" class="form-control text-light" readonly value="0" placeholder="0.00" />
                                    </div>
                                    <div class="col-md-3">
                                        <label>SGST</label>
                                        <input id="sgst" type="number" step="0.01" class="form-control text-light" readonly value="0" placeholder="0.00" />
                                    </div>
                                    <div class="col-md-3">
                                        <label>IGST</label>
                                        <input id="igst" type="number" step="0.01" class="form-control text-light" readonly value="0" placeholder="0.00" />
                                    </div>
                                    <div class="col-md-3">
                                        <label>Pincode</label>
                                        <input id="pincode" class="form-control" placeholder="Pincode" />
                                    </div>
                                </div>

                                <div class="row mt-2">
                                    <div class="col-md-3">
                                        <label>POS</label>
                                        <input id="pos" class="form-control" placeholder="POS" />
                                    </div>
                                    <div class="col-md-3">
                                        <label>State Code</label>
                                        <input id="stateCode" class="form-control" placeholder="State Code" />
                                    </div>
                                    <div class="col-md-3">
                                        <label>Location</label>
                                        <input id="loc" class="form-control" placeholder="Location" />
                                    </div>
                                    <div class="col-md-3">
                                        <label>Customer GSTIN</label>
                                        <input id="customerGstin" class="form-control" placeholder="Enter customer GSTIN (optional)" maxlength="15" />
                                    </div>
                                </div>
                                <div class="row mt-2">
                                    <div class="col-md-3">
                                        <label for="vehicleNo">Vehicle No</label>
                                        <input id="vehicleNo" class="form-control" placeholder="Vehicle No" maxlength="10" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label for="ownerName">Owner Name</label>
                                        <input id="ownerName" class="form-control" placeholder="Owner Name" maxlength="100" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label for="eWayBillNo">EWay Bill No</label>
                                        <input id="eWayBillNo" class="form-control" placeholder="EWay Bill No" maxlength="50" required />
                                    </div>
                                </div>
                            </fieldset>
                            <!-- Amount Paid and Balance placed here as requested -->
                            <div class="row mt-2">
                                <div class="col-md-3">
                                    <label>Amount Paid</label>
                                    <input id="amountPaid" type="number" step="0.01" min="0" class="form-control" value="0"
                                           oninput="this.value=this.value.replace(/[^0-9.]/g,''); var parts=this.value.split('.'); if(parts.length>2) this.value=parts[0]+'.'+parts.slice(1).join(''); if(parts[1]) parts[1]=parts[1].slice(0,2); this.value=parts.join('.')" />
                                </div>
                                <div class="col-md-3">
                                    <label>Balance Amount</label>
                                    <input id="balanceAmount" type="number" step="0.01" class="form-control text-light" readonly value="0" />
                                </div>
                                <div class="col-md-3">
                                    <label>Total Bill Amount</label>
                                    <input id="totalBillAmount" type="number" step="0.01" class="form-control text-light" readonly value="0" />
                                </div>
                            </div>

                            <div class="text-right mt-2">
                                <button id="generateInvoice" class="btn btn-success">Generate Estimate</button>
                                <button id="clearForm" class="btn btn-danger">Clear</button>
                            </div>

                        </div>
                    </div>

                    <input type="hidden" id="billId" value="" />
                    <input type="hidden" id="invoiceId" value="" />
                </div>
            </div>
        </div>
    </div>

</div>
@section Scripts {
    @await Html.PartialAsync("~/Views/Shared/_TabulatorScripts.cshtml")

    <script type="application/json" id="serverEditPayloadData">@Html.Raw(ViewBag.EditJson ?? "null")</script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // initialize Tabulator for items
            var container = document.getElementById('itemsTable');
            // TabulatorHelper.createTabulator returns a Promise that resolves to the grid instance
            var tablePromise = TabulatorHelper.createTabulator('#itemsTable', {
                data: [],
                layout: 'fitColumns',
                pagination: false,
                placeholder: 'No items added',
                columns: [
                    // Use the slNo field (assigned when rows are added) so top-inserted items show their sequence number
                    { title: 'Sl No.', field: 'slNo', width: 60, headerSort: false, hozAlign: 'left', formatter: function(cell) { try { return (cell.getValue() || ''); } catch (e) { return ''; } } },
                    // hidden ids and tax rates required for saving and editing
                    { title: 'ItemId', field: 'itemId', visible: false },
                    { title: 'ItemTypeId', field: 'itemTypeId', visible: false },
                    { title: 'CGST', field: 'cgst', visible: false },
                    { title: 'SGST', field: 'sgst', visible: false },
                    { title: 'IGST', field: 'igst', visible: false },
                    // Tracing fields required for correct server-side mapping and PDF generation
                    { title: 'OriginalCost', field: 'originalCost', visible: false },
                    { title: 'ChangedPrice', field: 'changedPrice', visible: false },
                    { title: 'IsPriceModified', field: 'isPriceModified', visible: false },
                    { title: 'DisplayPrice', field: 'displayPrice', visible: false },
                    { title: 'QtyPerType', field: 'qtyPerType', visible: false },
                    // computed effective price per TYPE unit after price changes and discount (hidden)
                    {
                        title: 'ItemCostFinal', field: 'itemCostFinal', visible: false, mutator: function(value, data) {
                            try {
                                var qtyPerType = Number(data.qtyPerType || 1) || 1;
                                var pricePerType = (Number(data.itemPrice || 0) || 0) * qtyPerType;
                                return Number(getEffectivePricePerType(pricePerType)).toFixed(2);
                            } catch (e) { return (Number(value || 0)).toFixed(2); }
                        }
                    },
                    { title: 'Item Code', field: 'itemCode', width: 110, editable: false, headerSort: false },
                    { title: 'Item Name', field: 'itemName', width: 250, editable: false, headerSort: false },
                    { title: 'Item Type', field: 'itemTypeName', width: 110, editable: false, headerSort: false },
                    { title: 'Detailed', field: 'detailed', width: 150, editable: false, headerSort: false },
                    // store quantity in the grid as lowest-level/base units (not per-type units)
                    {
                        title: 'Quantity', field: 'quantity', width: 100, headerSort: false,
                        editable: function(cell) { return !(cell.getRow().getData() || {}).isPacked; },
                        editor: 'number', editorParams: { min: 1, step: 1 },
                        validator: function(cell, value) { return Number.isInteger(Number(value)) && Number(value) >= 1; },
                        formatter: function(cell) { var d = cell.getData(); return (Number(d.quantity || 0)).toString(); }, hozAlign: 'right',
                         cellEdited: function(cell) {
                             recalcTotals();
                             refreshItemDetail(cell.getRow());
                         }
                    },
                    {
                        title: 'Individual cost', field: 'itemPrice', width: 120, headerSort: false,
                        editable: function(cell) { return !(cell.getRow().getData() || {}).isPacked; },
                        editor: 'number', editorParams: { min: 0, step: 0.01 },
                        validator: function(cell, value) { return isFinite(Number(value)) && Number(value) >= 0; },
                        cellEdited: function(cell) {
                            var itemPrice = Number(cell.getValue());
                            cell.getRow().update({ changedPrice: itemPrice, isPriceModified: true });
                            recalcTotals();
                        },
                        formatter: function(cell) {
                            try {
                                var data = cell.getData() || {};
                                 return '<span class="text-light">' + Number(data.itemPrice || 0).toFixed(2) + '</span>';
                            } catch (e) { return (Number(cell.getValue() || 0)).toFixed(2); }
                        }, hozAlign: 'right'
                    },
                    {
                        title: 'Total Cost', field: 'totalCost', mutator: function(value, data) {
                            try {
                                 var total = Number(data.quantity || 0) * Number(data.itemPrice || 0);
                                return total.toFixed(2);
                            } catch (e) { return '0.00'; }
                        }, formatter: function(cell) { try { return '<span class="text-light">' + (cell.getValue() || '0.00') + '</span>'; } catch (e) { return (cell.getValue() || '0.00'); } }, width: 120, headerSort: false, hozAlign: 'right'
                    },
                    {
                        title: 'Delete', formatter: function(cell) {
                            try {
                                var data = (cell && cell.getRow && cell.getRow().getData) ? cell.getRow().getData() : {};
                                if (data && data.isPacked === true) {
                                    // render a disabled control for packed rows
                                    return '<button class="btn btn-sm btn-danger" disabled title="Packed items cannot be deleted">Del</button>';
                                }
                            } catch (e) { }
                            return '<button class="btn btn-sm btn-danger">Del</button>';
                        }, width: 80, cellClick: function(e, cell) {
                            try {
                                var data = (cell && cell.getRow && cell.getRow().getData) ? cell.getRow().getData() : {};
                                if (data && data.isPacked === true) {
                                    try {
                                        var nm = (data.itemName || data.itemCode) ? (data.itemName || data.itemCode) : 'item';
                                        showMessage('Packed item "' + nm + '" cannot be deleted. Unpack the item before making changes.');
                                    } catch (ex) { alert('Packed items cannot be deleted.'); }
                                    return;
                                }
                            } catch (e) { }
                            try { cell.getRow().delete(); recalcTotals(); } catch (e) { }
                        }, headerSort: false, hozAlign: 'center'
                    }
                ]
            });

            // Server-provided edit payload (if any) is emitted into a separate script tag with type=application/json
            var serverEditPayload = null;
            try {
                var payloadElem = document.getElementById('serverEditPayloadData');
                if (payloadElem && payloadElem.textContent) {
                    serverEditPayload = JSON.parse(payloadElem.textContent);
                }
            } catch (e) { serverEditPayload = null; }
            var serverEditPayloadApplied = false;

            // Load customer types from server and populate select
            (function loadCustomerTypes() {
                try {
                    var url = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("GetCustomerTypes", "Billing")));
                    fetch(url).then(function(r) { return r.json(); }).then(function(resp) {
                        try {
                            if (resp && resp.success && Array.isArray(resp.data)) {
                                var sel = document.getElementById('customerType');
                                // clear existing but keep first placeholder
                                while (sel.options.length > 1) sel.remove(1);
                                resp.data.forEach(function(item) {
                                    try {
                                        var opt = document.createElement('option');
                                        opt.value = item.id;
                                        opt.text = item.name;
                                        sel.appendChild(opt);
                                    } catch (e) { }
                                });
                                // if server payload present, set selected value after options loaded and lock it (disable)
                                try {
                                    if (serverEditPayload && serverEditPayload.header && serverEditPayload.header.customerType) {
                                        sel.value = serverEditPayload.header.customerType;
                                        // once selected from payload (editing existing bill), do not allow change
                                        sel.disabled = true;
                                    }
                                } catch (e) { }
                            }
                        } catch (e) { }
                    }).catch(function() { /* ignore load error */ });
                } catch (e) { }
            })();

            // Once the user selects a customer type, lock (disable) the dropdown until save or clear
            try {
                var custTypeEl = document.getElementById('customerType');
                if (custTypeEl) {
                    custTypeEl.addEventListener('change', function() {
                        try {
                            var v = (this.value || '').toString().trim();
                            if (v !== '') this.disabled = true;
                        } catch (e) { }
                    });
                }
            } catch (e) { }

            // If payload present, populate form and table after Tabulator initialized
            if (serverEditPayload) {
                console.log('serverEditPayload',serverEditPayload)
                try {
                    // set header fields
                    try { document.getElementById('billId').value = (serverEditPayload.header && serverEditPayload.header.billId) ? serverEditPayload.header.billId : '0'; } catch (e) { }
                    try { document.getElementById('invoiceId').value = (serverEditPayload.header && serverEditPayload.header.invoiceId) ? serverEditPayload.header.invoiceId : ''; } catch (e) { }
                    try { document.getElementById('customerName').value = serverEditPayload.header.name || ''; } catch (e) { }
                    try { document.getElementById('address').value = serverEditPayload.header.custAddress || ''; } catch (e) { }
                    try { document.getElementById('mobile').value = serverEditPayload.header.mobileNo || ''; } catch (e) { }
                    try { if (serverEditPayload.header.mobile2 !== undefined) document.getElementById('mobile2').value = serverEditPayload.header.mobile2 || ''; } catch (e) { }
                    try { if (serverEditPayload.header.mobile2 !== undefined) document.getElementById('mobile2').value = serverEditPayload.header.mobile2 || ''; } catch (e) { }
                    try { document.getElementById('customerType').value = serverEditPayload.header.customerType || ''; } catch (e) { }
                    try { document.getElementById('discountPerItem').value = serverEditPayload.header.discountPerItem || '0'; } catch (e) { }
                    try { document.getElementById('discountPercentage').value = serverEditPayload.header.discountPercentage || '0'; } catch (e) { }
                    try { document.getElementById('billAmount').value = serverEditPayload.header.billAmount || '0'; } catch (e) { }
                    try { document.getElementById('amountPaid').value = serverEditPayload.header.amountPaid || '0'; } catch (e) { }
                    try { document.getElementById('balanceAmount').value = serverEditPayload.header.balanceAmount || '0'; } catch (e) { }
                    // invoice-specific
                    try { if (serverEditPayload.header.invoiceNo) document.getElementById('invoiceNo').value = serverEditPayload.header.invoiceNo || ''; } catch (e) { }
                    try { if (serverEditPayload.header.pos) document.getElementById('pos').value = serverEditPayload.header.pos || ''; } catch (e) { }
                    try { if (serverEditPayload.header.stateCode) document.getElementById('stateCode').value = serverEditPayload.header.stateCode || ''; } catch (e) { }
                    try { if (serverEditPayload.header.pincode) document.getElementById('pincode').value = serverEditPayload.header.pincode || ''; } catch (e) { }
                    try { if (serverEditPayload.header.loc) document.getElementById('loc').value = serverEditPayload.header.loc || ''; } catch (e) { }
                     try { document.getElementById('vehicleNo').value = serverEditPayload.header.vehicleNo || ''; } catch (e) { }
                     try { document.getElementById('ownerName').value = serverEditPayload.header.ownerName || ''; } catch (e) { }
                     try { document.getElementById('eWayBillNo').value = serverEditPayload.header.eWayBillNo || ''; } catch (e) { }

                    // set estimate/invoice radio once from server payload
                    try {
                        if (serverEditPayload && serverEditPayload.header) {
                            var hdrIsEstimate = !!serverEditPayload.header.isEstimate;
                            var estimateEl = document.getElementById('estimateRadio');
                            var invoiceEl = document.getElementById('invoiceRadio');
                            if (hdrIsEstimate) {
                                estimateEl.checked = true;
                                invoiceEl.checked = false;
                                // allow switching when this is an estimate
                                estimateEl.disabled = false;
                                invoiceEl.disabled = false;
                            } else {
                                // this record is an invoice: select invoice and prevent switching back to estimate
                                invoiceEl.checked = true;
                                estimateEl.checked = false;
                                estimateEl.disabled = true;
                                // ensure invoice radio remains enabled so user can view invoice state
                                invoiceEl.disabled = false;
                            }
                            // If server payload contains in-state flag, set stateType radio accordingly (important for out-of-state invoices)
                            try {
                                if (typeof serverEditPayload.header.isInState !== 'undefined' && serverEditPayload.header.isInState !== null) {
                                    var stVal = serverEditPayload.header.isInState ? 'in' : 'out';
                                    try { document.querySelector('input[name="stateType"][value="' + stVal + '"]').checked = true; } catch (e) { }
                                }
                            } catch (e) { }
                            serverEditPayloadApplied = true; // mark applied so toggleInvoiceDetails won't override user changes later
                        }
                    } catch (e) { }

                    // populate rows
                    if (serverEditPayload.items && serverEditPayload.items.length > 0) {
                        tablePromise.then(function(t) {
                            try {
                                var rowsToAdd = [];
                                serverEditPayload.items.forEach(function(it) {
                                    try {
                                        // compute display amounts for taxes while preserving percent values for persistence
                                        var qtyPerTypeRow = it.qtyPerType || 1;
                                         var taxableRow = Number(it.quantity || 0) * Number(it.itemPrice || 0);
                                        // Always preserve and use percentage values for taxes (do not store absolute amounts in the grid)
                                        var cgstPercentRow = (it.cgst !== undefined && it.cgst !== null) ? Number(it.cgst) : 0;
                                        var sgstPercentRow = (it.sgst !== undefined && it.sgst !== null) ? Number(it.sgst) : 0;
                                        var igstPercentRow = (it.igst !== undefined && it.igst !== null) ? Number(it.igst) : 0;

                                        rowsToAdd.push({
                                            slNo: it.slNo || 0,
                                            billId: it.billId || 0,
                                            itemId: it.itemId || 0,
                                            itemCode: it.itemCode || '',
                                            itemName: it.itemName || '',
                                            itemTypeId: it.itemTypeId || 0,
                                            itemTypeName: it.itemTypeName || it.itemType || '',
                                            detailed: it.detailed || '',
                                            quantity: it.quantity || 0,
                                            qtyPerType: it.qtyPerType || 1,
                                            itemPrice: it.itemPrice || it.originalCost || 0,
                                             itemCost: it.itemPrice || it.originalCost || 0,
                                            displayPrice: (it.itemPrice && it.qtyPerType) ? (it.itemPrice * it.qtyPerType) : (it.totalCost || 0),
                                            totalCost: it.totalCost || 0,
                                            // always store percentages in the row object; do not persist absolute tax amounts
                                            cgst: cgstPercentRow || 0,
                                            sgst: sgstPercentRow || 0,
                                            igst: igstPercentRow || 0,
                                            // preserve explicit percent fields as well for clarity
                                            cgstPercent: cgstPercentRow || 0,
                                            sgstPercent: sgstPercentRow || 0,
