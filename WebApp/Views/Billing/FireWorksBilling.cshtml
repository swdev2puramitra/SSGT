                                                    otherE.update({ itemId: itm.itemId, itemCode: itm.itemCode, itemName: itm.itemName, itemTypeId: itm.itemTypeId, itemTypeName: itm.itemTypeName, qtyPerType: itm.qtyPerType, quantity: itm.quantity, itemPrice: itm.itemPrice, detailed: itm.detailed, cgst: itm.cgst || 0, sgst: itm.sgst || 0, igst: itm.igst || 0 });
                                                    try {
                                                        var otcE = otherE.getCell('totalCost'); if (otcE && typeof otcE.setValue === 'function') {
                                                            var displayQtyO2 = (Number(itm.quantity || 0) / Number(itm.qtyPerType || 1)) || 0;
                                                            var pricePerTypeO2 = (Number(itm.itemPrice || 0) * Number(itm.qtyPerType || 1)) || 0;
                                                            otcE.setValue((displayQtyO2 * getEffectivePricePerType(pricePerTypeO2)).toFixed(2));
                                                        }
                                                    } catch (e) { }
                                                } catch (e) { }
                                                // remove editing row
                                                try { rowCompE.delete(); } catch (e) { }
                                            } else {
                                                // convert entered qty (type-units) to base-units using existing row's qtyPerType or entered
                                                var existing = rowCompE.getData() || {};
                                                var qtyPerExisting = Number(existing.qtyPerType || 1) || 1;
                                                var newQtyBaseE = Math.max(0, Number(qty || 0) * qtyPerExisting);
                                                var preservedPriceE = (existing.itemPrice !== undefined && existing.itemPrice !== null) ? existing.itemPrice : itm.itemPrice;
                                                rowCompE.update({ quantity: newQtyBaseE, itemPrice: preservedPriceE, itemTypeId: itm.itemTypeId, itemTypeName: itm.itemTypeName, qtyPerType: qtyPerExisting });
                                                try {
                                                    var ftcE = rowCompE.getCell('totalCost'); if (ftcE && typeof ftcE.setValue === 'function') {
                                                        var displayQtyE = (Number(newQtyBaseE || 0) / qtyPerExisting) || 0;
                                                        var pricePerTypeE = (Number(preservedPriceE || 0) * qtyPerExisting) || 0;
                                                        ftcE.setValue((displayQtyE * getEffectivePricePerType(pricePerTypeE)).toFixed(2));
                                                    }
                                                } catch (e) { }
                                            }
                                            recalcTotals(); try { tbl.redraw(true); } catch (e) { }
                                        }
                                    } catch (ee) { }
                                    // clear editing
                                    // clear editing state and reset UI
                                    clearEditingState();
                                    return;
                                }
                                var rows = tbl.getRows();
                                var found = null;
                                for (var i = 0; i < rows.length; i++) {
                                    var d = rows[i].getData();
                                    var existingItemId = parseInt(d.itemId || 0, 10);
                                    var existingTypeId = parseInt(d.itemTypeId || 0, 10);
                                    var newItemId = parseInt(itemId || 0, 10);
                                    var newTypeId = parseInt(itemTypeId || 0, 10);
                                    if (existingItemId === newItemId && existingTypeId === newTypeId) { found = rows[i]; break; }
                                }
                                if (found) {
                                    var d = found.getData();
                                    var qtyPer = Number(d.qtyPerType || 1) || 1;
                                    var addQtyBase = Number(qty || 0) * qtyPer;
                                    var newQty = Number(d.quantity || 0) + addQtyBase;
                                    var preservedPrice = (d.itemPrice !== undefined && d.itemPrice !== null) ? d.itemPrice : itm.itemPrice;
                                    // compute totalCost for updated row
                                    var discountPerItemVal2 = parseFloat((document.getElementById('discountPerItem') && document.getElementById('discountPerItem').value) || 0) || 0;
                                    var displayQtyAfter = (Number(newQty || 0) / qtyPer) || 0;
                                    var pricePerTypeAfter = (Number(preservedPrice || 0) * qtyPer) || 0;
                                    var effectivePriceAfter = getEffectivePricePerType(pricePerTypeAfter);
                                    var totalCostAfter = (displayQtyAfter * effectivePriceAfter).toFixed(2);
                                    found.update({ quantity: newQty, itemPrice: preservedPrice, totalCost: totalCostAfter, cgst: itm.cgst || 0, sgst: itm.sgst || 0, igst: itm.igst || 0, changedPrice: itm.changedPrice || null, isPriceModified: !!itm.isPriceModified });
                                    try { var ftc = found.getCell('totalCost'); if (ftc && typeof ftc.setValue === 'function') ftc.setValue(totalCostAfter); } catch (e) { }
                                    recalcTotals();
                                    try { tbl.redraw(true); } catch (e) { }
                                } else {
                                    try {
                                        // assign sequential SlNo for new row
                                        var existing = tbl.getData() || [];
                                        itm.slNo = (existing.length || 0) + 1;
                                    } catch (e) { itm.slNo = 0; }
                                    tbl.addRow(itm, true).then(function() { recalcTotals(); });
                                }
                            } catch (e) { }
                        });
                    });

                // clear inputs
                // clear editing state and reset UI
                clearEditingState();
            });

            // calculate item total on qty or cost change
            function calcItemTotal() {
                var q = parseFloat(document.getElementById('itemQty').value || '0');
                var c = parseFloat(document.getElementById('itemCost').value || '0');
                var t = (isNaN(q) || isNaN(c)) ? 0 : (q * c);
                document.getElementById('itemTotal').value = t.toFixed(2);
            }
            document.getElementById('itemQty').addEventListener('input', calcItemTotal);
            document.getElementById('itemCost').addEventListener('input', calcItemTotal);

            // ensure balance recalculates live while typing amountPaid and when discount/state changes
            try {
                var amountPaidEl = document.getElementById('amountPaid');
                if (amountPaidEl) amountPaidEl.addEventListener('input', function() { try { recalcTotals(); } catch (e) { } });
            } catch (e) { }
            try {
                var discountPerItemEl = document.getElementById('discountPerItem');
                if (discountPerItemEl) discountPerItemEl.addEventListener('input', function() { try { recalcTotals(); } catch (e) { } });
            } catch (e) { }
            try {
                var discountPercEl = document.getElementById('discountPercentage');
                if (discountPercEl) discountPercEl.addEventListener('input', function() { try { recalcTotals(); } catch (e) { } });
            } catch (e) { }
            try {
                var stateRadios = document.querySelectorAll('input[name="stateType"]');
                stateRadios.forEach(function(r) { r.addEventListener('change', function() { try { recalcTotals(); } catch (e) { } }); });
            } catch (e) { }

            // prefillItem implementation for Edit button in tabulator
            window.prefillItem = function(rowData) {
                if (!rowData) return;
                // set inputs from row and focus
                $('#itemSearch').val([rowData.itemCode, rowData.itemName].filter(Boolean).join(' - '));
                $('#itemCode').val(rowData.itemCode || '');
                $('#itemName').val(rowData.itemName || '');
                // itemPrice is stored as base-unit price; show inputs in per-type terms
                var qtyPerType = Number(rowData.qtyPerType || 1) || 1;
                var displayQty = (Number(rowData.quantity || 0) / qtyPerType) || 0;
                var pricePerType = (Number(rowData.itemPrice || 0) * qtyPerType) || 0;
                $('#itemQty').val(displayQty);
                $('#itemCost').val(pricePerType.toFixed(2));
                $('#itemTotal').val((displayQty * pricePerType).toFixed(2));
                // set itemId and itemType
                $('#itemCode').data('itemId', rowData.itemId || 0);
                if (rowData.itemTypeId) {
                    $('#itemType').val(rowData.itemTypeId);
                } else if (rowData.itemTypeName) {
                    // try to select by text if id not present
                    $('#itemType option').filter(function() { return $(this).text() === rowData.itemTypeName; }).prop('selected', true);
                }
                // do not change Add button or editing state when prefilling for edit
                // scroll to top inputs
                window.scrollTo(0, 0);
            };

            // add a programmatic Edit action for tabulator rows (mirror WinForms Edit button)
            // Tabulator: create an Edit handler that can be invoked from a custom column formatter or by double-clicking a row
            function attachRowEditHandler(tbl) {
                try {
                    tbl.on('rowDblClick', function(e, row) {
                        try { var d = row.getData(); window.prefillItem(d); } catch (e) { }
                    });
                } catch (e) { }
            }

            // Hook attachment when table is available
            withTable(function(t) { try { attachRowEditHandler(t); } catch (e) { } });

            // Save as estimate
            var saveInProgress = false;
            document.getElementById('generateInvoice').addEventListener('click', function(e) {
                e.preventDefault();
                if (saveInProgress) return;
                var isEstimate = !document.getElementById('invoiceRadio').checked; // if invoice radio checked, isEstimate=false
                // ensure discount defaults
                var discountPerItem = parseFloat(document.getElementById('discountPerItem').value || '0') || 0;
                var discountPercentage = parseFloat(document.getElementById('discountPercentage').value || '0') || 0;
                var isInState = (document.querySelector('input[name="stateType"]:checked') || {}).value === 'in';

                // --- Validation before save ---
                try {
                    if (!isEstimate && document.getElementById('billId').value == '') { alert('Direct invoice is not allowed. Generate Estimate first.'); return; }

                    // customer type must be selected
                    var customerTypeVal = (document.getElementById('customerType').value || '').toString();
                    if (!customerTypeVal) { alert('Select Customer Type'); return; }

                    // invoice number required for Invoice (not for Estimate)
                    // var isInvoice = document.getElementById('invoiceRadio').checked;
                    // if (isInvoice) {
                    //     var invNo = (document.getElementById('invoiceNo').value || '').toString().trim();
                    //     if (!invNo) { alert('Invoice number is required when generating an invoice'); return; }
                    // }

                    // discounts must be non-negative
                    //if (discountPerItem < 0) { alert('Discount per item cannot be negative'); return; }
                    if (discountPercentage < 0) { alert('Discount percentage cannot be negative'); return; }

                    // items validation: at least one row and each row valid
                    var rowsPreview = [];
                    try { if (table && table.getData) rowsPreview = table.getData(); } catch (e) { rowsPreview = []; }
                    if (!rowsPreview || rowsPreview.length === 0) { alert('Add at least one item before saving'); return; }
                    for (var ri = 0; ri < rowsPreview.length; ri++) {
                        var rr = rowsPreview[ri] || {};
                        var iid = parseInt(rr.itemId || 0);
                        var qty = parseFloat(rr.quantity || 0) || 0;
                        var price = parseFloat(rr.itemPrice || 0) || 0;
                        if (iid <= 0) { alert('One or more items are invalid (missing Item).'); return; }
                        if (qty <= 0) { alert('Quantity must be greater than zero for all items'); return; }
                        if (price < 0) { alert('Item price cannot be negative'); return; }
                    }

                    // customer identification: if no existing customer id, mobile must be 10 digits so we can create/find
                    var customerIdEl = document.getElementById('customerId');
                    var existingCustomerId = customerIdEl ? parseInt(customerIdEl.value || '0') : 0;
                    var mobileStr = (document.getElementById('mobile').value || '').toString().trim();
                    if (!existingCustomerId) {
                        if (!mobileStr || mobileStr.length !== 10) { alert('Enter a 10-digit mobile number to fetch/create customer'); return; }
                        // ensure digits only
                        if (!/^\d{10}$/.test(mobileStr)) { alert('Mobile number must contain only digits'); return; }
                    }
                } catch (ve) { alert('Validation error'); return; }

                // Lock the action after validation and before any asynchronous work.
                // This prevents double-clicks from opening competing save transactions.
                saveInProgress = true;
                var saveButton = this;
                saveButton.disabled = true;
                saveButton.dataset.originalText = saveButton.textContent;
                saveButton.textContent = 'Saving...';

                // helper to build item DTOs from table rows
                function buildItems() {
                    var rows = [];
                    try {
                        if (table && table.getData)
                            rows = table.getData();
                    } catch (e) { rows = []; }
                    return rows.map(function(r) {
                        // OriginalCost: use r.originalCost if present else itemPrice per base unit
                        var original = (r.originalCost !== undefined && r.originalCost !== null) ? Number(r.originalCost) : (Number(r.itemPrice || 0) || 0);
                        // ItemPrice is the final price for bill (per base unit)
                        var itemPriceFinal = Number(r.itemPrice || 0) || 0;
                        // Preserve client-side price modification state for persistence.
                        var changed = (r.changedPrice !== undefined && r.changedPrice !== null) ? Number(r.changedPrice) : null;
                        var isModifiedFlag = !!r.isPriceModified;
                        if (isModifiedFlag && changed === null) changed = itemPriceFinal;
                        if (!isModifiedFlag) changed = null;
                        console.log('r', r);
                        return {
                            SlNo: parseInt(r.slNo || 0),
                            ItemId: parseInt(r.itemId || 0),
                            ItemName: r.itemName || '',
                            ItemTypeId: r.itemTypeId || 0,
                            ItemPrice: itemPriceFinal,
                             ItemCost: itemPriceFinal,
                            Quantity: parseInt(r.quantity || 0) || 0,
                             SellType: parseInt(r.sellType || r.itemTypeId || 0) || 0,
                             SellQty: parseInt(r.sellQty || 0) || 0,
                            OriginalCost: original,
                            ChangedPrice: changed,
                            IsPriceModified: !!isModifiedFlag,
                            TotalCost: Number(r.totalCost || 0) || 0,
                            // prefer sending percentages from client (cgst, sgst, igst stored as percent values on row)
                            CgstPercent: (!isEstimate && isInState) ? 9 : 0,
                            SgstPercent: (!isEstimate && isInState) ? 9 : 0,
                            IgstPercent: (!isEstimate && !isInState) ? 18 : 0,
                            // keep absolute amounts for backward compatibility (server will compute amounts from percents)
                            CgstAmount: Number(r.cgstAmount || 0) || 0,
                            SgstAmount: Number(r.sgstAmount || 0) || 0,
                            IgstAmount: Number(r.igstAmount || 0) || 0
                        };
                    });
                }

                // ensure we have a customer id: try hidden input #customerId first
                var customerIdEl = document.getElementById('customerId');
                var existingCustomerId = customerIdEl ? parseInt(customerIdEl.value) : 0;
                var mobileVal = parseInt(document.getElementById('mobile').value || '0') || 0;
                var mobile2Val = parseInt(document.getElementById('mobile2').value || '0') || 0;

                function doSave(customerIdToUse) {
                    // Do not pre-open a blank tab (causes about:blank resolution issues).
                    // We'll open the preview URL in a new tab after the server responds.

                    var payload = {
                        BillId: parseInt(document.getElementById('billId').value || '0'),
                        InvoiceId: parseInt(document.getElementById('invoiceId').value || '0') || null,
                        MobileNo: mobileVal,
                        Mobile2: mobile2Val,
                        //CustomerId: customerIdToUse || 0,
                        CustomerType: parseInt(document.getElementById('customerType').value || '1'),
                        IsEstimate: isEstimate,
                        Name: document.getElementById('customerName').value || '',
                        Address: document.getElementById('address').value || '',
                        CustomerGstin: document.getElementById('customerGstin') ? document.getElementById('customerGstin').value || '' : '',
                        InvoiceNo: document.getElementById('invoiceNo').value || '',
                        // Include invoice header fields so controller can persist when converting estimate -> invoice
                        Invoice: document.getElementById('invoiceNo') ? document.getElementById('invoiceNo').value || '' : '',
                        POS: document.getElementById('pos') ? document.getElementById('pos').value || '' : '',
                        StateCode: document.getElementById('stateCode') ? document.getElementById('stateCode').value || '' : '',
                        Pincode: document.getElementById('pincode') ? document.getElementById('pincode').value || '' : '',
                        Loc: document.getElementById('loc') ? document.getElementById('loc').value || '' : '',
                         VehicleNo: document.getElementById('vehicleNo') ? document.getElementById('vehicleNo').value || '' : '',
                         OwnerName: document.getElementById('ownerName') ? document.getElementById('ownerName').value || '' : '',
                         EWayBillNo: document.getElementById('eWayBillNo') ? document.getElementById('eWayBillNo').value || '' : '',
                        AmountPaid: parseFloat(document.getElementById('amountPaid').value || '0') || 0,
                        BalanceAmount: parseFloat(document.getElementById('balanceAmount').value || '0') || 0,
                        DiscountPerItem: discountPerItem,
                        DiscountPercentage: discountPercentage,
                        IsInState: isInState,
                        Items: buildItems()
                    };

                    var postBillingUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("FireWorksBilling", "Billing")));
                    fetch(postBillingUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
                        .then(function(r) { return r.json(); })
                        .then(function(resp) {
                            if (resp && resp.success) {
                                alert('Bill generated successfully');
                                if (resp.billId) {
                                    document.getElementById('billId').value = resp.billId;
                                    try { toggleInvoiceDetails(); updateGenerateButton(); } catch (e) { }
                                }

                                // Handle preview in new tab and optional redirect for edits
                                try {
                                    var rawPreview = '';
                                    if (resp.previewUrl && resp.previewUrl.toString) rawPreview = resp.previewUrl.toString();
                                    if ((!rawPreview || !rawPreview.trim()) && resp && resp.billId) {
                                        try {
                                            var tmpl = isEstimate ? 'Estimate' : (isInState ? 'InvoiceInState' : 'InvoiceOutOfState');
                                            rawPreview = previewPdfBaseUrl + '?billId=' + encodeURIComponent(resp.billId) + '&template=' + encodeURIComponent(tmpl);
                                        } catch (ce) { rawPreview = ''; }
                                    }

                                    if (rawPreview && rawPreview.trim()) {
                                        var absPreviewUrl = rawPreview;
                                        try { absPreviewUrl = new URL(rawPreview, window.location.origin).toString(); } catch (uerr) { absPreviewUrl = rawPreview; }
                                        // Try to open preview in a new tab
                                        var newWin = null;
                                        try { newWin = window.open(absPreviewUrl, '_blank'); if (newWin) try { newWin.focus(); } catch (e) { } } catch (e) { newWin = null; }
                                        // If this save is an invoice conversion (not an estimate) and server returned a billId, redirect to View Bills after opening preview
                                        try {
                                            if (!isEstimate && resp && resp.billId && Number(resp.billId) > 0) {
                                                try { window.location = viewBillsUrl.toString ? viewBillsUrl.toString() : viewBillsUrl; return; } catch (e) { try { window.location = viewBillsUrl; return; } catch (ee) { /* ignore */ } }
                                            }
                                        } catch (e) { /* ignore redirect errors */ }
                                        // If server explicitly provided redirectUrl, honor it (fallback)
                                        if (resp.redirectUrl) {
                                            try { window.location = resp.redirectUrl.toString(); return; } catch (e) { try { window.location = resp.redirectUrl; return; } catch (ee) { /* ignore */ } }
                                        }
                                    } else {
                                        // No preview URL available; if server provided redirectUrl, navigate current window
                                        if (!isEstimate && resp && resp.billId && Number(resp.billId) > 0) {
                                            try { window.location = viewBillsUrl.toString ? viewBillsUrl.toString() : viewBillsUrl; return; } catch (e) { try { window.location = viewBillsUrl; return; } catch (ee) { /* ignore */ } }
                                        }
                                        if (resp.redirectUrl) {
                                            try { window.location = resp.redirectUrl.toString(); return; } catch (e) { try { window.location = resp.redirectUrl; return; } catch (ee) { /* ignore */ } }
                                        }
                                    }
                                } catch (e) { console.warn('Error handling preview/redirect', e); }

                                // clear table and reset form to new bill (only if not redirected)
                                try { if (table) safeClearTable(table); } catch (e) { }
                                // reset fields
                                try { document.getElementById('customerName').value = ''; } catch (e) { }
                                try { document.getElementById('address').value = ''; } catch (e) { }
                                try { document.getElementById('invoiceNo').value = ''; } catch (e) { }
                                try { document.getElementById('billAmount').value = '0'; } catch (e) { }
                                try { document.getElementById('billId').value = '0'; } catch (e) { }
                                try { document.getElementById('discountPerItem').value = '0'; } catch (e) { }
                                try { document.getElementById('discountPercentage').value = '0'; } catch (e) { }
                                try { document.getElementById('cgst').value = '0'; } catch (e) { }
                                try { document.getElementById('sgst').value = '0'; } catch (e) { }
                                try { document.getElementById('igst').value = '0'; } catch (e) { }
                                // clear amount paid and balance
                                try { document.getElementById('amountPaid').value = '0'; } catch (e) { }
                                try { document.getElementById('balanceAmount').value = '0'; } catch (e) { }
                                // clear customer id hidden
                                try { if (customerIdEl) customerIdEl.value = ''; } catch (e) { }
                                // re-enable customer type dropdown for next bill
                                try { document.getElementById('customerType').disabled = false; document.getElementById('customerType').value = ''; } catch (e) { }
                                // reset invoice selection to Estimate
                                try { document.getElementById('estimateRadio').checked = true; document.getElementById('invoiceRadio').checked = false; toggleInvoiceDetails(); updateGenerateButton(); } catch (e) { }
                                try { document.getElementById('mobile').value = ''; } catch (e) { }
                                try { document.getElementById('taxableAmount').value = ''; } catch (e) { }
                                try { document.getElementById('totalBillAmount').value = '0'; } catch (e) { }

                            } else {
                                saveInProgress = false;
                                saveButton.disabled = false;
                                saveButton.textContent = saveButton.dataset.originalText || 'Save';
                                var details = resp && Array.isArray(resp.errors) ? resp.errors : [];
                                var message = (resp && resp.message) || 'Unable to save billing.';
                                if (details.length) message += '\\n\\n' + details.join('\\n');
                                alert('Error: ' + message);
                            }
                        })
                        .catch(function() {
                            saveInProgress = false;
                            saveButton.disabled = false;
                            saveButton.textContent = saveButton.dataset.originalText || 'Save';
                            alert('Error saving billing');
                        });
                }

                // if customer id already present, use it
                if (existingCustomerId && existingCustomerId > 0) { doSave(existingCustomerId); return; }

                // Do not perform a GetCustomerByMobile lookup in the save flow.
                // Customer lookup is already performed by the mobile input listener when the user types 10 digits.
                // If there is no resolved customer id here, proceed with save flow using customerId = 0
                doSave(0);
                return;

                // fallback: proceed without fetching when mobile not 10 chars
                doSave(0);
            });

            document.getElementById('clearForm').addEventListener('click', function(e) {
                e.preventDefault();
                try { if (table && table.clearData) table.clearData(); } catch (e) { }
                document.getElementById('customerName').value = ''; document.getElementById('address').value = ''; document.getElementById('invoiceNo').value = ''; document.getElementById('billAmount').value = '0'; document.getElementById('billId').value = '0';
                try { document.getElementById('mobile').value = ''; } catch (e) { }
                try { document.getElementById('taxableAmount').value = '0'; } catch (e) { }
                try { document.getElementById('discountPerItem').value = '0'; document.getElementById('discountPercentage').value = '0'; } catch (e) { }
                try { document.getElementById('amountPaid').value = '0'; document.getElementById('balanceAmount').value = '0'; } catch (e) { }
                try { document.getElementById('cgst').value = '0'; document.getElementById('sgst').value = '0'; document.getElementById('igst').value = '0'; } catch (e) { }
                try { document.getElementById('customerType').disabled = false; document.getElementById('customerType').value = ''; } catch (e) { }
                try { document.getElementById('estimateRadio').checked = true; document.getElementById('invoiceRadio').checked = false; toggleInvoiceDetails(); updateGenerateButton(); } catch (e) { }
            });

            // update totals when cell edited
            withTable(function(tbl) {
                try { tbl.on('cellEdited', function(cell) { recalcTotals(); }); } catch (e) { }
            });
        });
    </script>
}
