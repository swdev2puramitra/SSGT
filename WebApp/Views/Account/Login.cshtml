@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h1 class="login-title">Sai Ganesh Traders</h1>
            <p class="login-subtitle">Inventory Management System</p>
        </div>

        <div class="login-body">
            <form asp-action="Login" method="post" id="loginForm">
                <div class="form-group mb-4">
                    <label asp-for="UserName" class="form-label">Username</label>
                    <input asp-for="UserName" class="form-control form-control-lg credentials" placeholder="Enter your username" />
                    <span asp-validation-for="UserName" class="invalid-feedback d-block"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="UserPassword" class="form-label">Password</label>
                    <input asp-for="UserPassword" class="form-control form-control-lg credentials" type="password" placeholder="Enter your password" />
                    <span asp-validation-for="UserPassword" class="invalid-feedback d-block"></span>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mb-4" role="alert">
                        <strong>Login Failed</strong>
                        <p class="mb-0">@ViewBag.Error</p>
                    </div>
                }

                <div class="d-grid gap-3 mb-4">
                    <button type="submit" class="btn btn-primary btn-lg" id="btnLogin">
                        <span class="glow-blue">Sign In</span>
                    </button>
                </div>

                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-outline-secondary" id="btnReset">Clear</button>
                </div>
            </form>
        </div>

        <div class="login-footer">
            <p class="text-center text-muted small">© 2026 Sai Ganesh Traders. All rights reserved.</p>
        </div>
    </div>
</div>

<script src="~/js/SHA256.js" asp-append-version="true"></script>

@section Scripts {
    <script>
        $(function () {
            $('#UserName').focus();
            $("#loginForm").submit(function () {
                var pwd = $("#UserPassword").val();
                var hashed = hex_sha256(pwd);
                $("#UserPassword").val(hashed);
            });

            $("#btnReset").click(function () {
                $("#loginForm")[0].reset();
            });
        });
    </script>
}
