@{
    ViewData["Title"] = "View Bills";
    var bills = ViewBag.Bills as List<WebApp.Models.BillsListDto> ?? new List<WebApp.Models.BillsListDto>();
}

<div class="container-fluid mt-0 mb-1">
    <!-- Header -->
    <div class="dashboard-header">
        <h3>View Bills</h3>
    </div>

    <!-- Filters Section -->
    <div class="filters-section">
        <form method="get" action="@Url.Action("ViewBills")" class="filter-form">
            <div class="filter-row">
                <div class="filter-group">
                    <label for="createdDate">Bill Date</label>
                    <input type="date" id="createdDate" name="createdDate"
                           value="@(ViewBag.SelectedCreatedDate?.ToString("yyyy-MM-dd") ?? "")"
                           class="form-control filter-input" />
                </div>

                <div class="filter-group">
                    <label for="name">Customer Name</label>
                    <input type="text" id="name" name="name"
                           placeholder="Enter customer name"
                           value="@ViewBag.SelectedName"
                           class="form-control filter-input" />
                </div>

                <div class="filter-group">
                    <label for="billNo">Bill No</label>
                    <input type="text" id="billNo" name="billNo"
                           placeholder="Enter bill number"
                           value="@ViewBag.SelectedBillNo"
                           class="form-control filter-input" />
                </div>

                <div class="filter-group">
                    <label for="mobileNo">Mobile No</label>
                    <input type="tel" id="mobileNo" name="mobileNo"
                           placeholder="Enter mobile number"
                           value="@ViewBag.SelectedMobileNo"
                           class="form-control filter-input" />
                </div>
            </div>

            <div class="filter-row">
                <div class="filter-group">
                    <label for="customerType">Customer Type</label>
                    <select id="customerType" name="customerType" class="form-control filter-select">
                        <option value="">-- Select --</option>
                        @if (Convert.ToString(ViewBag.SelectedCustomerType) == "1")
                        {
                            <option value="1" selected>Wholesale</option>
                        }
                        else
                        {
                            <option value="1">Wholesale</option>
                        }
                        @if (Convert.ToString(ViewBag.SelectedCustomerType) == "2")
                        {
                            <option value="2" selected>Semi-Wholesale</option>
                        }
                        else
                        {
                            <option value="2">Semi-Wholesale</option>
                        }
                        @if (Convert.ToString(ViewBag.SelectedCustomerType) == "3")
                        {
                            <option value="3" selected>Retail</option>
                        }
                        else
                        {
                            <option value="3">Retail</option>
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label for="isEstimate">Type</label>
                    <select id="isEstimate" name="isEstimate" class="form-control filter-select">
                        <option value="">-- Select --</option>
                        @if (Convert.ToString(ViewBag.SelectedIsEstimate) == "E")
                        {
                            <option value="E" selected>Estimate</option>
                        }
                        else
                        {
                            <option value="E">Estimate</option>
                        }
                        @if (Convert.ToString(ViewBag.SelectedIsEstimate) == "I")
                        {
                            <option value="I" selected>Invoice</option>
                        }
                        else
                        {
                            <option value="I">Invoice</option>
                        }
                    </select>
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search"></i> Search
                    </button>
                    <a href="@Url.Action("ViewBills")" class="btn btn-secondary">
                        <i class="fas fa-redo"></i> Clear
                    </a>
                </div>

                <!-- empty placeholder to keep 4-column alignment with the first row -->
                <div class="filter-group" aria-hidden="true"></div>
            </div>
        </form>
    </div>

    <!-- Error Message -->
    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @ViewBag.Error
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
        </div>
    }

    <!-- Results Count -->
    <div class="results-info">
        <p id="resultsInfo">Found <strong>0</strong> bill(s)</p>
    </div>

    <!-- Tabulator Grid Container -->
    <div class="tabulator-wrapper">
        <div id="billsGrid"></div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_TabulatorScripts")

    <script>
        // Define columns for this page; helper partial will reuse this variable
        window.TABULATOR_COLUMNS = [
            { title: 'SL', field: 'slNo', width: 60, hozAlign: 'center' },
            { title: 'Bill No', field: 'billNo', width: 100 },
            { title: 'Customer', field: 'customerName', width: 120 },
            { title: 'Address', field: 'custAddress', width: 120 },
            { title: 'Type', field: 'customerType', width: 80 },
            { title: 'Phone', field: 'phoneNo', width: 100 },
            { title: 'Amount', field: 'billAmount', hozAlign: 'right', width: 90, formatter: function(cell) { const v = cell.getValue(); return v ? parseFloat(v).toFixed(2) : '0.00'; } },
            { title: 'Date', field: 'billDate', width: 140, formatter: 'datetime', formatterParams: { inputFormat: 'iso', outputFormat: 'dd-MMM-yyyy hh:mm a', invalidPlaceholder: '(invalid date)' } },
            { title: 'Invoice', field: 'invoiceNo', width: 100 },
            { title: 'Estimate?', field: 'estimate', width: 100 },
            { title: 'WayBill', field: 'wayBill', width: 100 },
            { title: 'Actions', field: 'actions', hozAlign: 'center', width: 150, formatter: function(cell) {
                    var data = cell.getRow().getData();
                    var id = data.billId || '';
                    var buttons = '<div class="d-flex gap-1 justify-content-center">';
                    if(window.CURRENT_USER_ROLE === 1){
                        buttons += '<button class="btn btn-sm btn-info action-edit" data-billid="' + id + '"><i class="fas fa-edit"></i></button>';
                    }
                    // Admins can reopen the packing dashboard after dispatch; use an alternate color.
                    var dispatchStatus = (data.DispatchStatus || data.dispatchStatus || '') + '';
                    var isDispatched = dispatchStatus === 'D';
                    if(window.CURRENT_USER_ROLE === 1 || window.CURRENT_USER_ROLE === 2 || !dispatchStatus || (dispatchStatus !== 'D' && dispatchStatus !== 'C' && dispatchStatus !== 'P')){
                        buttons += '<button class="btn btn-sm ' + (isDispatched ? 'btn-dispatch-completed' : 'btn-primary') + ' action-dispatch" data-billid="' + id + '" title="' + (isDispatched ? 'Open packing dashboard' : 'Dispatch bill') + '"><i class="fa-solid fa-truck-fast"></i></button>';
                    }
                    buttons += '<button class="btn btn-sm btn-secondary action-print" data-billid="' + id + '"><i class="fas fa-print"></i></button>';
                    var estimateValue = (data.estimate || data.Estimate || '') + '';
                    var isInvoiceRow = estimateValue.toLowerCase() === 'no' || estimateValue.toLowerCase() === 'invoice' || !!data.invoiceNo;
                    if (isInvoiceRow && data.invoiceNo) {
                        buttons += '<button class="btn btn-sm btn-warning action-split" data-billid="' + id + '" data-invoiceid="' + (data.invoiceId || id) + '" data-invoiceno="' + (data.invoiceNo || '') + '" title="Split invoice by items"><i class="fas fa-code-branch"></i></button>';
                    }
                    buttons += '</div>';
                    return buttons;
                } }
        ];

        // Expose current user role to client scripts (1 = admin, 2 = semi-admin)
        window.CURRENT_USER_ROLE = @((ViewBag.UserRole ?? 0));

        // Pass configuration to shared helper via ViewBag-like globals
        window.TABULATOR_CONFIG = {
            selector: '#billsGrid',
            ajaxUrl: '@Url.Action("GetBillsPage", "Home")',
            pageSize: 10,
            initialData: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bills ?? new List<WebApp.Models.BillsListDto>())),
            totalCount: @((ViewBag.TotalBillsCount ?? 0))
                };
    </script>

    @Html.Partial("_TabulatorHelper")
    <script>
        // View-specific dispatch handling (keeps logic out of shared helper)
        (function(){
            function findRowDataByBillId(table, billId){
                try{
                    var rows = table.getRows();
                    for(var i=0;i<rows.length;i++){
                        var d = rows[i].getData();
                        if(d && (d.BillId == billId || d.billId == billId)) return d;
                    }
                }catch(e){}
                return null;
            }

            document.addEventListener('DOMContentLoaded', function(){
                var container = document.querySelector('#billsGrid');
                if(!container) return;

                container.addEventListener('click', function(e){
                    var t = e.target;
                    if(t.tagName === 'I' && t.parentElement) t = t.parentElement;
                    var bid = t.getAttribute && t.getAttribute('data-billid');
                    if(!bid) return;

                    // Handle edit action here (page-specific)
                    if(t.classList.contains('action-edit')){
                        var userRole = window.CURRENT_USER_ROLE || 0;
                        if(userRole === 1){
                            window.location.href = '/Billing/FireWorksBilling?billId=' + encodeURIComponent(bid);
                        } else {
                            alert('Access denied: only administrators can edit bills.');
                        }
                        return;
                    }

                    if(t.classList.contains('action-split')){
                        window.location.href = '/Billing/SplitInvoice?invoiceId=' + encodeURIComponent(t.getAttribute('data-invoiceid')) + '&invoiceNo=' + encodeURIComponent(t.getAttribute('data-invoiceno') || '');
                        return;
                    }

                    if(t.classList.contains('action-dispatch')){
                        var userRole = window.CURRENT_USER_ROLE || 0;
                        var numericBillId = parseInt(bid,10);
                        if(userRole === 2){
                            window.location.href = '/Reports/PackingDashboard?billId=' + encodeURIComponent(numericBillId);
                            return;
                        }
                        var rowData = null;
                        if(window._tabulator_table) rowData = findRowDataByBillId(window._tabulator_table, numericBillId);
             
                        var isEstimate = (rowData && (rowData.IsEstimateInvoice || rowData.isEstimate || rowData.estimate)) || '';
                        var estimateFlag = (isEstimate === 'E' || ('' + isEstimate).toLowerCase() === 'yes');

                        var dispatchStatus = (rowData && (rowData.DispatchStatus || rowData.dispatchStatus)) || '';
                        var isInvoiced = !estimateFlag && (('' + isEstimate).toUpperCase() === 'I' || ('' + isEstimate).toLowerCase() === 'no');
                        if(isInvoiced){
                            window.location.href = '/Reports/PackingDashboard?billId=' + numericBillId;
                            return;
                        }

                        if(userRole === 1 && dispatchStatus === 'D'){
                            window.location.href = '/Reports/PackingDashboard?billId=' + numericBillId;
                            return;
                        }

                        // Non-admin behavior remains unchanged for already dispatched/completed bills.
                        if(dispatchStatus && (dispatchStatus === 'D' || dispatchStatus === 'C')){
                            alert('Bill No: ' + (rowData && (rowData.BillNo || rowData.billNo)) + ' is already dispatched.');
                            return;
                        }
               
                        // Admin (role=1) & estimate bills only -> confirm and set DispatchStatus = 'D'
                        if(userRole === 1 && estimateFlag){
                            if(!confirm('Confirm dispatch for bill ' + rowData.billNo + '?')) return;

                            fetch('/Reports/SetDispatch',{
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ BillId: numericBillId, Status: 'D' })
                            }).then(function(r){ return r.json(); }).then(function(res){
                                if(res && res.success){
                                    alert('Dispatch status updated.');
                                    try{ window._tabulator_table.setData(window.TABULATOR_CONFIG.ajaxUrl, {}); }catch(e){ location.reload(); }
                                }else{
                                    alert('Error updating dispatch: ' + (res && res.message ? res.message : 'Unknown'));
                                }
                            }).catch(function(err){ console.error(err); alert('Error updating dispatch status'); });

                            return;
                        }
                        else if(!estimateFlag){
                            alert('Bill No: '+rowData.billNo +' is already converted to invoice')
                        }

                        // Default fallback -> redirect to packing dashboard
                        //window.location.href = '/Reports/PackingDashboard?billId=' + numericBillId;
                    }
                });
            });
        })();
        // View-specific Print handling: open PreviewPdf with correct template for this page only.
        (function(){
            function findRowDataByBillId(table, billId){
                try{
                    var rows = table.getRows();
                    for(var i=0;i<rows.length;i++){
                        var d = rows[i].getData();
                        if(d && (d.BillId == billId || d.billId == billId)) return d;
                    }
                }catch(e){}
                return null;
            }

            document.addEventListener('DOMContentLoaded', function(){
                var container = document.querySelector('#billsGrid');
                if(!container) return;

                container.addEventListener('click', function(e){
                    var t = e.target;
                    if(t.tagName === 'I' && t.parentElement) t = t.parentElement;
                    var bid = t.getAttribute && t.getAttribute('data-billid');
                    if(!bid) return;

                    if(t.classList.contains('action-print')){
                        // Prevent shared helper from handling this click
                        try{ e.stopImmediatePropagation(); }catch(ex){}

                        var numericBillId = parseInt(bid,10);
                        var rowData = null;
                        if(window._tabulator_table) rowData = findRowDataByBillId(window._tabulator_table, numericBillId);

                        var tmpl = 'Estimate';
                        try{
                            var isEstimate = (rowData && (rowData.IsEstimateInvoice || rowData.isEstimate || rowData.estimate)) || '';
                            var isInState = (rowData && (rowData.IsInState || rowData.isInState)) || false;
                            var custType = (rowData && (rowData.CustomerType || rowData.customerType || rowData.customerTypeText)) || '';

                            var estimateFlag = (isEstimate === 'E' || (('' + isEstimate).toLowerCase() === 'yes') || isEstimate === true);
                            var inStateFlag = (isInState === true || ('' + isInState).toLowerCase() === 'true');
                            var isRetail = false;
                            try { if(('' + custType).toLowerCase().indexOf('ret') >= 0) isRetail = true; } catch(e){}
                            try { if(!isRetail && parseInt(('' + custType)) === 3) isRetail = true; } catch(e){}

                            if(estimateFlag) tmpl = 'Estimate';
                            else if(isRetail) tmpl = 'RetailThermal';
                            else tmpl = inStateFlag ? 'InvoiceInState' : 'InvoiceOutOfState';
                        }catch(e){ tmpl = 'Estimate'; }
                        var url = '/Billing/PreviewPdf?billId=' + encodeURIComponent(bid) + '&template=' + encodeURIComponent(tmpl);
                        try { window.open(url, '_blank'); } catch(e) { window.location.href = url; }
                    }
                });
            });
        })();
    </script>
}
