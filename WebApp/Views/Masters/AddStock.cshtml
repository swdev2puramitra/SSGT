@using WebApp.Models
@{
    ViewData["Title"] = "Add Stock";
    var godowns = ViewBag.Godowns as List<FwMasterGodown> ?? new List<FwMasterGodown>();
    var companies = ViewBag.Companies as List<FwMasterCompanyName> ?? new List<FwMasterCompanyName>();
}

<div class="container-fluid mt-0 mb-1">
    <div class="dashboard-header">
        <h3>Add Stock</h3>
    </div>

    <div id="stockFormMessage" class="alert d-none" role="status"></div>

    <form id="stockReceiptForm" class="card stock-receipt-form">
        @Html.AntiForgeryToken()
        <input id="stockId" type="hidden" value="" />

        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-lg-4">
                    <label for="godownId" class="form-label">Godown</label>
                    <select id="godownId" class="form-control" required>
                        <option value="">-- Select Godown --</option>
                        @foreach (var godown in godowns)
                        {
                            <option value="@godown.Id">@godown.GodownDescription</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-lg-8 align-self-end text-end">
                    <button id="addStockItemButton" type="button" class="btn btn-outline-primary">Add Item</button>
                </div>
            </div>
            <div class="tabulator-wrapper mt-3">
                <div id="stockReceiptGrid"></div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-12 col-lg-4">
                    <label for="stockFrom" class="form-label">Stock From (Company)</label>
                    <select id="stockFrom" class="form-control" required>
                        <option value="">-- Select Company --</option>
                        @foreach (var company in companies)
                        {
                            <option value="@company.CompanyName">@company.CompanyName</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-lg-4">
                    <label for="invoiceNo" class="form-label">Invoice No</label>
                    <input id="invoiceNo" class="form-control" maxlength="50" required />
                </div>
                <div class="col-12 col-lg-4">
                    <label for="arrivalDate" class="form-label">Arrival Date</label>
                    <input id="arrivalDate" class="form-control" type="date" required />
                </div>
                <div class="col-12">
                    <label for="comments" class="form-label">Comments</label>
                    <textarea id="comments" class="form-control" rows="3" maxlength="500"></textarea>
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button id="saveStockButton" type="submit" class="btn btn-primary">Save Stock</button>
                <button id="clearStockButton" type="button" class="btn btn-secondary">Clear</button>
                <a class="btn btn-outline-secondary" href="@Url.Action("ViewStockList", "Masters")">View Stock List</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @Html.Partial("_TabulatorScripts")
    <script>
        window.stockPageConfig = {
            suggestItemsUrl: '@Url.Action("SuggestItems", "Masters")',
            itemTypesUrl: '@Url.Action("GetStockItemTypes", "Masters")',
            itemDescriptionUrl: '@Url.Action("GetItemStockDesc", "Billing")',
            saveUrl: '@Url.Action("SaveStock", "Masters")',
            receiptUrl: '@Url.Action("GetStockReceipt", "Masters")',
            editStockId: new URLSearchParams(window.location.search).get('stockId') || ''
        };
    </script>
    <script src="~/js/Masters/stock-receipt.js" asp-append-version="true"></script>
}
