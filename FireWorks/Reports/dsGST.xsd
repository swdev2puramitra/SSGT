                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT CONVERT(DECIMAL(10,2),SUM(Quantity * (ItemCost - (ItemCost * DiscountPercentage/100)))) Taxable,
CONVERT(VARCHAR(20),BI.CGST) + ' %' CGST,CONVERT(DECIMAL(10,2),SUM(Quantity * (ItemCost - (ItemCost * DiscountPercentage/100)) * BI.CGST/100)) CGSTAmt,
CONVERT(VARCHAR(20),BI.SGST) + ' %' SGST,CONVERT(DECIMAL(10,2),SUM(Quantity * (ItemCost - (ItemCost * DiscountPercentage/100)) * BI.SGST/100)) SGSTAmt,
CONVERT(VARCHAR(20),BI.IGST) + ' %' IGST,CONVERT(DECIMAL(10,2),SUM(Quantity * (ItemCost - (ItemCost * DiscountPercentage/100)) * BI.IGST/100)) IGSTAmt,

CONVERT(DECIMAL(10,2),SUM(Quantity * (ItemCost - (ItemCost * DiscountPercentage/100)) * BI.CGST/100)) +
CONVERT(DECIMAL(10,2),SUM(Quantity * (ItemCost - (ItemCost * DiscountPercentage/100)) * BI.SGST/100)) +
CONVERT(DECIMAL(10,2),SUM(Quantity * (ItemCost - (ItemCost * DiscountPercentage/100)) * BI.IGST/100)) Total
	
FROM FW_Invoice_Items BI
INNER JOIN FW_Invoice B ON BI.BillId = B.BillId
WHERE B.BillId = 10085
GROUP BY BI.CGST,BI.SGST,BI.IGST</CommandText>
